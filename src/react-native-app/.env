# https://docs.expo.dev/guides/environment-variables/

EXPO_PUBLIC_FRONTEND_PROXY_PORT=8080

# Splunk RUM (Digital Experience Analytics) - https://docs.splunk.com/observability/en/gdi/get-data-in/rum/react/get-react-native-data-in.html
# RUM access tokens are meant to be public/client-side, see Splunk's docs on generating one in Splunk Observability Cloud.
# Personal values (app name, realm, token, ...) belong in .env.local, which is git-ignored and overrides this file.
EXPO_PUBLIC_SPLUNK_APP_NAME=react-native-app
EXPO_PUBLIC_SPLUNK_REALM=
EXPO_PUBLIC_SPLUNK_RUM_ACCESS_TOKEN=
EXPO_PUBLIC_SPLUNK_DEPLOYMENT_ENVIRONMENT=local
# NO_TRACKING or ANONYMOUS_TRACKING
EXPO_PUBLIC_SPLUNK_USER_TRACKING_MODE=ANONYMOUS_TRACKING
