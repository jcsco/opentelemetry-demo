FRONTEND_PROXY_PORT=8080

# Splunk RUM (Digital Experience Analytics) - https://docs.splunk.com/observability/en/gdi/get-data-in/rum/flutter/get-flutter-data-in.html
# RUM access tokens are meant to be public/client-side, see Splunk's docs on generating one in Splunk Observability Cloud.
SPLUNK_REALM=
SPLUNK_RUM_ACCESS_TOKEN=
SPLUNK_DEPLOYMENT_ENVIRONMENT=local
# NO_TRACKING or ANONYMOUS_TRACKING
SPLUNK_USER_TRACKING_MODE=ANONYMOUS_TRACKING
